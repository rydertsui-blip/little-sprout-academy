{
  "name": "little-sprout-family",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:sources": "tsx scripts/verify-sources.ts",
    "coverage:sources": "tsx scripts/verify-sources.ts --summary",
    "verify:content": "tsx scripts/verify-content.ts",
    "update:content": "tsx scripts/verify-content.ts --update",
    "update:question-ids": "tsx scripts/update-question-ids.ts",
    "build": "npm run verify:sources && npm run verify:content && tsc -b && vite build && cp src/manual-sw.js ../../family/sw.js && node scripts/postbuild.mjs"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.3",
    "lucide-react": "^1.77.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
